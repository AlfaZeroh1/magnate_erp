# Uploaded files are data, never code.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php\d)$">
    Require all denied
</FilesMatch>
<FilesMatch "\.(jpe?g|png|webp|gif)$">
    Require all granted
</FilesMatch>
